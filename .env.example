# WorkRelay environment configuration

WORKRELAY_ENV=development

# Decision provider:
# local  = deterministic provider, no Google Cloud credentials required
# gemini = Gemini + Google ADK via Vertex AI
WORKRELAY_DECISION_PROVIDER=local

# State store:
# local     = local JSON-backed state
# firestore = Google Cloud Firestore
WORKRELAY_STATE_STORE=local

# Google Cloud / Gemini configuration
# Required when WORKRELAY_DECISION_PROVIDER=gemini
GOOGLE_GENAI_USE_ENTERPRISE=TRUE
GOOGLE_CLOUD_PROJECT=workrelay
GOOGLE_CLOUD_LOCATION=global
